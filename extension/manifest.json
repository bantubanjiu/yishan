{
  "manifest_version": 3,
  "name": "移山",
  "version": "0.2.5",
  "description": "快速把网页内容、链接、图片和截图保存到 Obsidian。",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "notifications",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html"
  },
  "commands": {
    "quick-save-current-window": {
      "suggested_key": {
        "default": "Ctrl+Shift+S"
      },
      "description": "Quick save current window tabs to Obsidian"
    },
    "capture-screenshot-area": {
      "suggested_key": {
        "default": "Ctrl+Shift+X"
      },
      "description": "Capture selected area to Obsidian"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["gesture-content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

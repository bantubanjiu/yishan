{
  "manifest_version": 3,
  "name": "移山",
  "version": "0.1.0",
  "description": "快速把网页内容、链接、图片和截图保存到 Obsidian。",
  "permissions": ["contextMenus", "nativeMessaging", "notifications", "activeTab", "scripting", "tabs"],
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
